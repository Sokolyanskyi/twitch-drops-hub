# Optional: your own Twitch application client id.
# By default a public client id of the Twitch Smart TV client is used, which supports
# the Device Code Flow — the app works right after deployment without extra setup.
# Create your own: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=

# Optional: client secret of your own Twitch application.
# Only needed to refresh tokens of "confidential" applications.
TWITCH_CLIENT_SECRET=

# Optional: client id used for gql.twitch.tv requests.
# Falls back to TWITCH_CLIENT_ID.
TWITCH_GQL_CLIENT_ID=

# Recommended: secret used to encrypt the token cookie (any string of 16+ characters).
# When unset, a development key is used.
SESSION_SECRET=

# Local UI preview without a Twitch account.
# DROPS_MOCK=1
